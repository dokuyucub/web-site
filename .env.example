# Sanity CMS - https://sanity.io/manage adresinden alın
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Token - Read + Write yetkili token
SANITY_API_READ_TOKEN=sk_your_read_token_here
SANITY_API_WRITE_TOKEN=sk_your_write_token_here

# Sanity Webhook Secret - rastgele bir string girin
SANITY_WEBHOOK_SECRET=your_webhook_secret_here

# Resend Email API - https://resend.com adresinden alın
RESEND_API_KEY=re_your_resend_api_key_here

# E-posta bildirimlerinin gönderileceği adres
CONTACT_EMAIL_TO=your@email.com
CONTACT_EMAIL_FROM=noreply@yourdomain.com

# Site URL'i
NEXT_PUBLIC_BASE_URL=http://localhost:3000
